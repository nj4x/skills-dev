{
  "name": "vscode-agent-bridge",
  "displayName": "VS Code Agent Bridge",
  "description": "Companion extension for the vscode-agent-bridge MCP server: installs cline-sr hook scripts, holds the liveness WebSocket, and submits bridged tasks to cline-sr.",
  "version": "0.1.0",
  "publisher": "nj4x",
  "private": true,
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {},
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "install-dev": "bash scripts/install-dev.sh"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0"
  }
}
